rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function activeMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return activeMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /members/{uid} {
      // Pengguna hanya dapat membaca profil keanggotaannya sendiri; admin dapat mengelola anggota.
      allow read: if activeMember() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /memories/{memoryId} {
      allow read: if activeMember();
      // Versi awal: hanya admin yang dapat menambah/mengubah/menghapus metadata album.
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('familyPhotos/[A-Za-z0-9-]+')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.size is int
        && request.resource.data.size <= 5242880;
      allow update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100;
      allow delete: if isAdmin();
    }
  }
}
